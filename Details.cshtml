@model EventDetailsViewModel
@{ ViewData["Title"] = Model.Event.EventName; }
<div class="card rd-card shadow-sm mb-4">
    @if (Model.Event.BannerBlobName is not null)
    {
        <img src="@Url.Action("EventImage", new { id = Model.Event.EventID })" class="card-img-top rd-banner-lg" alt="Event banner" />
    }
    <div class="card-body">
        <span class="badge rd-status-@Model.Event.Status">@Model.Event.Status</span>
        @if (!string.IsNullOrEmpty(Model.Event.EventType)) { <span class="badge bg-secondary">@Model.Event.EventType</span> }
        <h2 class="mt-2">@Model.Event.EventName</h2>
        <p class="text-muted">📅 @Model.Event.EventDate.ToString("dddd, dd MMM yyyy HH:mm") &nbsp; 📍 @Model.Event.Location</p>
        @if (Model.Event.DistanceKM.HasValue) { <p><strong>Distance:</strong> @Model.Event.DistanceKM km</p> }
        <p>@Model.Event.Description</p>
    </div>
</div>
<h4>Available categories</h4>
@if (!Model.Categories.Any())
{
    <div class="alert alert-info">No categories published yet — check back soon.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead><tr><th>Category</th><th>Distance</th><th>Age range</th><th>Entry fee</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model.Categories)
        {
            <tr>
                <td>@c.CategoryName</td>
                <td>@c.DistanceKM km</td>
                <td>@c.MinimumAge – @(c.MaximumAge?.ToString() ?? "+")</td>
                <td>@c.EntryFee.ToString("C")</td>
                <td class="text-end">
                    @if (User.IsInRole("Participant"))
                    {
                        @if (Model.AlreadyEnrolled)
                        {
                            <span class="badge bg-success">Enrolled ✓</span>
                        }
                        else if (Model.Event.Status == "Open")
                        {
                            <a class="btn btn-sm rd-btn-accent" asp-controller="Participant" asp-action="Enrol" asp-route-id="@Model.Event.EventID">Enrol</a>
                        }
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}
