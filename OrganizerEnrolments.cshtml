@model EnrolmentsViewModel
@{ ViewData["Title"] = "Enrolments — " + Model.Event.EventName; }
<h1 class="h4 mb-1">Enrolments — @Model.Event.EventName</h1>
<p class="text-muted">@Model.Event.EventDate.ToString("dd MMM yyyy") — @Model.Event.Location</p>
<div class="card rd-card shadow-sm">
    <div class="card-body">
        @if (!Model.Enrolments.Any())
        {
            <div class="alert alert-info mb-0">No participants enrolled yet.</div>
        }
        else
        {
            <table class="table align-middle">
                <thead><tr><th>Participant</th><th>Category</th><th>Status</th><th>Bib #</th></tr></thead>
                <tbody>
                @foreach (var e in Model.Enrolments)
                {
                    <tr>
                        <td>@e.Participant</td>
                        <td>@e.Category</td>
                        <td>
                            @if (e.EnrollmentStatus == "Confirmed") { <span class="badge bg-success">Confirmed</span> }
                            else if (e.EnrollmentStatus == "Pending") { <span class="badge bg-warning text-dark">Pending</span> }
                            else { <span class="badge bg-secondary">@e.EnrollmentStatus</span> }
                        </td>
                        <td>@(e.BibNumber ?? "—")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
<div class="mt-3"><a class="btn btn-outline-secondary btn-sm" asp-action="Dashboard">← Back to dashboard</a></div>
