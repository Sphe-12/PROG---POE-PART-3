@model ResultsEntryViewModel
@{ ViewData["Title"] = "Results entry — " + Model.Event.EventName; }
<h1 class="h4 mb-1">Results entry — @Model.Event.EventName</h1>
<p class="text-muted">Capture finish times and positions after the event concludes.</p>
@if (!Model.Enrolments.Any())
{
    <div class="alert alert-info">No participants enrolled for this event.</div>
}
else
{
    <div class="card rd-card shadow-sm"><div class="card-body">
        <table class="table align-middle">
            <thead><tr><th>Participant</th><th>Category</th><th>Time (seconds)</th><th>Position</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var e in Model.Enrolments)
            {
                <tr>
                    <form asp-action="RecordResult" method="post">
                        <input type="hidden" name="eventId" value="@Model.Event.EventID" />
                        <input type="hidden" name="enrollmentId" value="@e.EnrollmentID" />
                        <td>@e.Participant</td>
                        <td>@e.Category</td>
                        <td><input name="finishTimeSeconds" type="number" min="1" class="form-control form-control-sm" placeholder="e.g. 5025" /></td>
                        <td><input name="position" type="number" min="1" class="form-control form-control-sm" placeholder="e.g. 47" /></td>
                        <td>
                            <select name="resultStatus" class="form-select form-select-sm">
                                <option>Finished</option><option>DNF</option><option>Disqualified</option>
                            </select>
                        </td>
                        <td class="text-end"><button class="btn btn-sm rd-btn-accent">Save</button></td>
                    </form>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
}
<div class="mt-3"><a class="btn btn-outline-secondary btn-sm" asp-action="Dashboard">← Back to dashboard</a></div>
