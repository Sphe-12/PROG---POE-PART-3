@model EventFormViewModel
@{ ViewData["Title"] = Model.EventID.HasValue ? "Edit event" : "Create event"; }
<h1 class="h3 mb-4">@ViewData["Title"]</h1>
<div class="card rd-card shadow-sm">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <form method="post" enctype="multipart/form-data"
              asp-action="@(Model.EventID.HasValue ? "EditEvent" : "CreateEvent")">
            <input type="hidden" asp-for="EventID" />
            <input type="hidden" asp-for="HasBanner" />
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">Event name *</label>
                    <input asp-for="EventName" class="form-control" /><span asp-validation-for="EventName" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Event type</label>
                    <select asp-for="EventType" class="form-select">
                        <option value="">— select —</option>
                        @foreach (var t in new[] { "Road Race", "Trail Run", "Marathon", "Half Marathon", "10K", "5K", "Fun Run" })
                        {
                            <option value="@t" selected="@(Model.EventType == t)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Date &amp; time *</label>
                    <input asp-for="EventDate" class="form-control" type="datetime-local" />
                    <span asp-validation-for="EventDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Location *</label>
                    <input asp-for="Location" class="form-control" /><span asp-validation-for="Location" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Distance (km)</label>
                    <input asp-for="DistanceKM" class="form-control" type="number" step="0.1" min="0" />
                    <span asp-validation-for="DistanceKM" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select asp-for="Status" class="form-select">
                        @foreach (var s in new[] { "Upcoming", "Open", "Closed", "Completed", "Cancelled" })
                        {
                            <option value="@s" selected="@(Model.Status == s)">@s</option>
                        }
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label">Banner image (max 5 MB)</label>
                    <input asp-for="Banner" class="form-control" type="file" accept="image/*" />
                    @if (Model.HasBanner && Model.EventID.HasValue)
                    {
                        <div class="mt-2">
                            <span class="small text-muted">Current banner:</span><br />
                            <img src="@Url.Action("EventImage", "Home", new { id = Model.EventID })" class="rd-banner-preview" alt="Current banner" />
                        </div>
                    }
                </div>
            </div>
            <div class="mt-4">
                <button class="btn rd-btn-accent">Save event</button>
                <a class="btn btn-outline-secondary" asp-action="Dashboard">Cancel</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
