@model CategoriesViewModel
@{ ViewData["Title"] = "Categories — " + Model.Event.EventName; }
<h1 class="h4 mb-1">@Model.Event.EventName</h1>
<p class="text-muted">@Model.Event.EventDate.ToString("dd MMM yyyy") — @Model.Event.Location</p>
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card rd-card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Categories</h5>
                @if (!Model.Categories.Any()) { <div class="alert alert-info mb-0">No categories yet.</div> }
                else
                {
                    <table class="table">
                        <thead><tr><th>Name</th><th>Distance</th><th>Age</th><th>Fee</th></tr></thead>
                        <tbody>
                        @foreach (var c in Model.Categories)
                        {
                            <tr><td>@c.CategoryName</td><td>@c.DistanceKM km</td><td>@c.MinimumAge – @(c.MaximumAge?.ToString() ?? "+")</td><td>@c.EntryFee.ToString("C")</td></tr>
                        }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card rd-card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Add category</h5>
                <form asp-action="AddCategory" method="post">
                    <input type="hidden" asp-for="Form.EventId" />
                    <div class="mb-2"><label class="form-label">Name *</label><input asp-for="Form.CategoryName" class="form-control" placeholder="e.g. Junior 5K" /><span asp-validation-for="Form.CategoryName" class="text-danger"></span></div>
                    <div class="row g-2">
                        <div class="col-6 mb-2"><label class="form-label">Distance (km) *</label><input asp-for="Form.DistanceKM" class="form-control" /><span asp-validation-for="Form.DistanceKM" class="text-danger"></span></div>
                        <div class="col-6 mb-2"><label class="form-label">Entry fee *</label><input asp-for="Form.EntryFee" class="form-control" /><span asp-validation-for="Form.EntryFee" class="text-danger"></span></div>
                        <div class="col-6 mb-2"><label class="form-label">Min age *</label><input asp-for="Form.MinimumAge" class="form-control" /><span asp-validation-for="Form.MinimumAge" class="text-danger"></span></div>
                        <div class="col-6 mb-2"><label class="form-label">Max age</label><input asp-for="Form.MaximumAge" class="form-control" /><span asp-validation-for="Form.MaximumAge" class="text-danger"></span></div>
                    </div>
                    <button class="btn rd-btn-accent w-100">Add category</button>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="mt-3"><a class="btn btn-outline-secondary btn-sm" asp-action="Dashboard">← Back to dashboard</a></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
