@model OrganizerDashboardViewModel
@{ ViewData["Title"] = "Organiser dashboard"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Organiser dashboard</h1>
    <a class="btn rd-btn-accent" asp-action="CreateEvent">+ New event</a>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card rd-card shadow-sm text-center p-3"><div class="display-6 fw-bold rd-accent-text">@Model.UpcomingCount</div><div class="text-muted">Upcoming events</div></div></div>
    <div class="col-md-4"><div class="card rd-card shadow-sm text-center p-3"><div class="display-6 fw-bold rd-accent-text">@Model.Events.Count</div><div class="text-muted">Total events</div></div></div>
    <div class="col-md-4"><div class="card rd-card shadow-sm text-center p-3"><div class="display-6 fw-bold rd-accent-text">@Model.TotalEnrolments</div><div class="text-muted">Total enrolments</div></div></div>
</div>
<div class="card rd-card shadow-sm">
    <div class="card-body">
        <h5 class="card-title">My events</h5>
        @if (!Model.Events.Any()) { <div class="alert alert-info mb-0">You have not created any events yet.</div> }
        else
        {
            <table class="table align-middle">
                <thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Type</th><th>Status</th><th>Enrolments</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                @foreach (var e in Model.Events)
                {
                    <tr>
                        <td class="fw-semibold">@e.EventName</td>
                        <td>@e.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@e.Location</td>
                        <td>@(e.EventType ?? "—")</td>
                        <td><span class="badge rd-status-@e.Status">@e.Status</span></td>
                        <td><span class="badge bg-dark">@e.EnrolmentCount</span></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-dark" asp-action="EditEvent" asp-route-id="@e.EventID">Edit</a>
                            <a class="btn btn-sm btn-outline-dark" asp-action="Categories" asp-route-id="@e.EventID">Categories</a>
                            <a class="btn btn-sm btn-outline-dark" asp-action="Enrolments" asp-route-id="@e.EventID">Enrolments</a>
                            <a class="btn btn-sm btn-outline-dark" asp-action="Results" asp-route-id="@e.EventID">Results</a>
                            <form asp-action="DeleteEvent" asp-route-id="@e.EventID" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this event and all its categories and enrolments?');">
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        }
    </div>
</div>
